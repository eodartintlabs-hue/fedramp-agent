{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://fedramp.gov/schemas/fedramp-agent/tpir-register.schema.json",
  "title": "FedRAMP Third-Party Information Resource (TPIR) Register",
  "description": "Schema for tracking certified and non-certified Third-Party Information Resources used by AI agents (inference endpoints, vector databases, MCP tool servers, observability sinks, CI/CD runners) aligned with CR-26 MAS-CSO-TPR and FRC-CSO-PKG thirdPartyInformationResources conventions.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cso_package_id",
    "agent_id",
    "service_class",
    "last_updated",
    "thirdPartyInformationResources"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"
    },
    "cso_package_id": {
      "type": "string",
      "minLength": 1
    },
    "agent_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "service_class": {
      "type": "string",
      "enum": ["C", "D"]
    },
    "last_updated": {
      "type": "string",
      "format": "date-time"
    },
    "thirdPartyInformationResources": {
      "type": "object",
      "additionalProperties": false,
      "required": ["certified", "nonCertified"],
      "properties": {
        "certified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "fedRampCertifiedThirdPartyInformationResource",
              "name",
              "provider",
              "website",
              "useCase",
              "generalUsageAndConfiguration",
              "justification",
              "mitigationMeasures",
              "compensatingControls"
            ],
            "properties": {
              "fedRampCertifiedThirdPartyInformationResource": {
                "type": "string",
                "minLength": 1
              },
              "name": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "website": { "type": "string", "minLength": 1 },
              "useCase": { "type": "string", "minLength": 1 },
              "generalUsageAndConfiguration": { "type": "string", "minLength": 1 },
              "justification": { "type": "string", "minLength": 1 },
              "mitigationMeasures": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "compensatingControls": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        },
        "nonCertified": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "provider",
              "website",
              "useCase",
              "generalUsageAndConfiguration",
              "justification",
              "mitigationMeasures",
              "compensatingControls"
            ],
            "properties": {
              "name": { "type": "string", "minLength": 1 },
              "provider": { "type": "string", "minLength": 1 },
              "website": { "type": "string", "minLength": 1 },
              "useCase": { "type": "string", "minLength": 1 },
              "generalUsageAndConfiguration": { "type": "string", "minLength": 1 },
              "justification": { "type": "string", "minLength": 1 },
              "mitigationMeasures": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              },
              "compensatingControls": {
                "type": "array",
                "minItems": 1,
                "items": { "type": "string", "minLength": 1 }
              }
            }
          }
        }
      }
    }
  }
}
